<style>
/* ==========================================================================
   TRINITY FUELS — Design System
   Palette: Deep Forest Green + Antique Gold + Charcoal, on a warm parchment white
   Type: Fraunces (display, heritage serif) + Inter (body) + IBM Plex Mono (data/eyebrows)
   ========================================================================== */

:root {
  /* Colour tokens */
  --green-deep:   #0E3B2E;
  --green-mid:    #1B5E45;
  --green-soft:   #2C7A5B;
  --gold:         #C89B3C;
  --gold-light:   #E7CE8C;
  --charcoal:     #191919;
  --ink:          #24241F;
  --bg:           #FBFAF5;
  --bg-alt:       #F1EDE1;
  --bg-deep-alt:  #0B2C22;
  --white:        #FFFFFF;
  --line:         rgba(14, 59, 46, 0.14);
  --line-light:   rgba(255, 255, 255, 0.18);
  --shadow:       0 20px 50px -20px rgba(14, 27, 22, 0.35);

  /* Type */
  --font-display: 'Fraunces', 'Georgia', serif;
  --font-body:    'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-mono:    'IBM Plex Mono', 'Courier New', monospace;

  /* Layout */
  --container: 1180px;
  --radius-sm: 4px;
  --radius-md: 10px;
  --header-h: 84px;
}

/* ---------- Reset ---------- */
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
}
body, h1, h2, h3, h4, p, figure, blockquote, dl, dd { margin: 0; }
ul, ol { margin: 0; padding: 0; list-style: none; }
img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
button { font: inherit; cursor: pointer; }
input, textarea, select { font: inherit; }

body {
  font-family: var(--font-body);
  color: var(--ink);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  line-height: 1.6;
  overflow-x: hidden;
}

.container {
  max-width: var(--container);
  margin: 0 auto;
  padding: 0 32px;
}

h1, h2, h3, h4 {
  font-family: var(--font-display);
  color: var(--green-deep);
  font-weight: 600;
  line-height: 1.12;
  letter-spacing: -0.01em;
}

h1 { font-size: clamp(2.4rem, 4.6vw, 4.4rem); font-weight: 500; }
h2 { font-size: clamp(1.9rem, 3.2vw, 2.9rem); }
h3 { font-size: clamp(1.25rem, 1.8vw, 1.55rem); }

p { color: var(--ink); }
p.lead { font-size: 1.2rem; color: #3d4038; max-width: 62ch; }

.eyebrow {
  font-family: var(--font-mono);
  font-size: 0.74rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--gold);
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  font-weight: 500;
}
.eyebrow::before {
  content: "";
  width: 28px;
  height: 1px;
  background: var(--gold);
  display: inline-block;
}
.eyebrow.on-dark { color: var(--gold-light); }

.section {
  padding: 108px 0;
  position: relative;
}
.section--tight { padding: 76px 0; }
.section--alt { background: var(--bg-alt); }
.section--deep {
  background: linear-gradient(160deg, var(--green-deep) 0%, #0A2A20 100%);
  color: var(--white);
}
.section--deep h2, .section--deep h3 { color: var(--white); }
.section--deep p { color: rgba(255,255,255,0.82); }

.section-head { max-width: 720px; margin-bottom: 56px; }
.section-head.center { margin-left: auto; margin-right: auto; text-align: center; }

/* ---------- Watermark triquetra (signature motif) ---------- */
.knot-mark {
  position: absolute;
  pointer-events: none;
  opacity: 0.07;
  z-index: 0;
}
.section--deep .knot-mark { opacity: 0.10; }
.knot-mark svg { width: 100%; height: 100%; }
.section > .container, .hero__inner { position: relative; z-index: 1; }

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 15px 30px;
  font-family: var(--font-mono);
  font-size: 0.8rem;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
  transition: all 0.25s ease;
  white-space: nowrap;
}
.btn-primary {
  background: var(--gold);
  color: var(--green-deep);
  font-weight: 600;
}
.btn-primary:hover { background: var(--gold-light); transform: translateY(-2px); }
.btn-outline {
  border-color: rgba(255,255,255,0.4);
  color: var(--white);
}
.btn-outline:hover { border-color: var(--gold); color: var(--gold-light); }
.btn-outline-dark {
  border-color: var(--green-deep);
  color: var(--green-deep);
}
.btn-outline-dark:hover { background: var(--green-deep); color: var(--white); }
.btn-arrow { transition: transform 0.25s ease; }
.btn:hover .btn-arrow { transform: translateX(4px); }

/* ==========================================================================
   HEADER / NAV
   ========================================================================== */
.site-header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  height: var(--header-h);
  display: flex;
  align-items: center;
  background: rgba(251, 250, 245, 0.0);
  border-bottom: 1px solid transparent;
  transition: background 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
}
.site-header.is-scrolled,
.site-header.is-solid {
  background: rgba(251, 250, 245, 0.94);
  backdrop-filter: blur(10px);
  border-bottom-color: var(--line);
  box-shadow: 0 8px 30px -20px rgba(14,27,22,0.4);
}
.site-header .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}
.brand { display: flex; align-items: center; gap: 12px; }
.brand img { height: 48px; width: auto; border-radius: 6px; }
.brand__word { font-family: var(--font-display); font-size: 1.05rem; letter-spacing: 0.03em; color: var(--green-deep); line-height: 1.1; }
.brand__word strong { display: block; font-size: 1.3rem; font-weight: 600; }
.brand__word span { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.18em; color: var(--gold); text-transform: uppercase; }

.nav { display: flex; align-items: center; gap: 40px; }
.nav__links { display: flex; gap: 34px; }
.nav__links a {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink);
  position: relative;
  padding: 6px 0;
}
.nav__links a::after {
  content: "";
  position: absolute;
  left: 0; right: 100%;
  bottom: 0;
  height: 2px;
  background: var(--gold);
  transition: right 0.25s ease;
}
.nav__links a:hover::after,
.nav__links a.is-active::after { right: 0; }
.nav__links a.is-active { color: var(--green-deep); font-weight: 600; }

.nav__cta { display: none; }
@media (min-width: 900px) { .nav__cta { display: inline-flex; } }

.hamburger {
  display: flex;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  padding: 6px;
}
.hamburger span { width: 24px; height: 2px; background: var(--green-deep); display: block; transition: transform 0.25s ease, opacity 0.25s ease; }
@media (min-width: 900px) { .hamburger { display: none; } }
@media (max-width: 899px) { .nav__links { display: none; } }

.mobile-nav {
  position: fixed;
  inset: var(--header-h) 0 0 0;
  background: var(--green-deep);
  z-index: 999;
  transform: translateY(-8px);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease, transform 0.3s ease;
  display: flex;
  flex-direction: column;
  padding: 40px 32px;
  gap: 28px;
}
.mobile-nav.is-open { opacity: 1; transform: translateY(0); pointer-events: auto; }
.mobile-nav a {
  font-family: var(--font-display);
  font-size: 1.7rem;
  color: var(--white);
  border-bottom: 1px solid rgba(255,255,255,0.12);
  padding-bottom: 20px;
}
.mobile-nav a.is-active { color: var(--gold-light); }
.mobile-nav .btn { align-self: flex-start; margin-top: 8px; }

/* ==========================================================================
   HERO
   ========================================================================== */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  background: radial-gradient(120% 120% at 85% -10%, #164B39 0%, var(--green-deep) 45%, #08201A 100%);
  color: var(--white);
  overflow: hidden;
  padding-top: var(--header-h);
}
.hero--page {
  min-height: 62vh;
  padding-bottom: 64px;
}
.hero__inner { max-width: 760px; padding: 80px 0; }
.hero .eyebrow { color: var(--gold-light); }
.hero .eyebrow::before { background: var(--gold-light); }
.hero h1 { color: var(--white); margin-bottom: 26px; }
.hero p.lead { color: rgba(255,255,255,0.86); margin-bottom: 40px; }
.hero__ctas { display: flex; gap: 16px; flex-wrap: wrap; }

.hero__knot {
  position: absolute;
  top: 50%; right: -6%;
  width: min(60vw, 720px);
  height: min(60vw, 720px);
  transform: translateY(-50%);
  opacity: 0.9;
}

.hero__scroller {
  position: absolute;
  bottom: 36px; left: 32px;
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.6);
}
.hero__scroller .line { width: 40px; height: 1px; background: rgba(255,255,255,0.4); overflow: hidden; }
.hero__scroller .line::after {
  content: "";
  display: block;
  width: 100%; height: 100%;
  background: var(--gold);
  animation: scrollpulse 2.2s ease-in-out infinite;
}
@keyframes scrollpulse {
  0% { transform: translateX(-100%); }
  50% { transform: translateX(0%); }
  100% { transform: translateX(100%); }
}

/* Breadcrumb strip under page hero */
.strip {
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background: var(--bg);
}
.strip .container {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 40px;
  padding: 20px 32px;
  font-family: var(--font-mono);
  font-size: 0.74rem;
  letter-spacing: 0.06em;
  color: var(--green-mid);
  text-transform: uppercase;
}
.strip strong { color: var(--charcoal); }

/* ==========================================================================
   GRIDS / CARDS
   ========================================================================== */
.grid {
  display: grid;
  gap: 28px;
}
.grid--2 { grid-template-columns: repeat(2, 1fr); }
.grid--3 { grid-template-columns: repeat(3, 1fr); }
.grid--4 { grid-template-columns: repeat(4, 1fr); }
@media (max-width: 980px) {
  .grid--3, .grid--4 { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .grid--2, .grid--3, .grid--4 { grid-template-columns: 1fr; }
}

.card {
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 34px 30px;
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
}
.card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: rgba(200,155,60,0.4); }
.card__icon {
  width: 46px; height: 46px;
  margin-bottom: 20px;
  color: var(--gold);
}
.card h3 { margin-bottom: 12px; }
.card p { color: #52564B; font-size: 0.97rem; }

.card--dark {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.14);
}
.card--dark h3 { color: var(--gold-light); }
.card--dark p { color: rgba(255,255,255,0.78); }

.tag-list { display: flex; flex-wrap: wrap; gap: 10px; }
.tag {
  font-family: var(--font-mono);
  font-size: 0.76rem;
  letter-spacing: 0.03em;
  padding: 9px 16px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--green-deep);
  background: var(--white);
}
.section--deep .tag { border-color: rgba(255,255,255,0.22); color: var(--white); background: transparent; }

.check-list { display: grid; gap: 14px; }
.check-list li { display: flex; align-items: flex-start; gap: 12px; font-size: 1rem; }
.check-list .check {
  flex: none;
  width: 22px; height: 22px;
  border-radius: 50%;
  background: var(--gold);
  color: var(--green-deep);
  display: flex; align-items: center; justify-content: center;
  font-size: 0.7rem;
  margin-top: 2px;
}

.stat {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.stat strong {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 4vw, 3.4rem);
  color: var(--gold);
  font-weight: 600;
  line-height: 1;
}
.stat span {
  font-family: var(--font-mono);
  font-size: 0.76rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.7);
}

/* Two column split section */
.split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
@media (max-width: 900px) { .split { grid-template-columns: 1fr; gap: 40px; } }

.divider {
  height: 1px;
  background: var(--line);
  border: none;
  margin: 0;
}
.section--deep .divider { background: rgba(255,255,255,0.14); }

blockquote.scripture {
  font-family: var(--font-display);
  font-style: italic;
  font-size: clamp(1.3rem, 2vw, 1.7rem);
  color: var(--green-deep);
  border-left: 3px solid var(--gold);
  padding-left: 28px;
  max-width: 640px;
}
.section--deep blockquote.scripture { color: var(--white); }
blockquote.scripture cite {
  display: block;
  margin-top: 16px;
  font-family: var(--font-mono);
  font-style: normal;
  font-size: 0.78rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold);
}

/* ---------- Map / regions list ---------- */
.region-panel {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 50px;
  align-items: start;
}
@media (max-width: 900px) { .region-panel { grid-template-columns: 1fr; } }
.region-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px 24px; }
.region-list li { padding: 12px 0; border-bottom: 1px solid var(--line); font-family: var(--font-mono); font-size: 0.86rem; letter-spacing: 0.02em; }
.region-list li strong { color:#C89B3C; font-family: var(--font-body); font-weight: 600; }

/* ==========================================================================
   PRODUCT DETAIL ROWS
   ========================================================================== */
.product-row {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 40px;
  padding: 40px 0;
  border-bottom: 1px solid var(--line);
}
.product-row:first-of-type { border-top: 1px solid var(--line); }
@media (max-width: 760px) { .product-row { grid-template-columns: 1fr; gap: 14px; } }
.product-row__tag {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--gold);
}
.product-row h3 { margin: 6px 0 10px; }
.product-row p { color: #52564B; max-width: 60ch; }
.product-row ul.inline { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 14px; }
.product-row ul.inline li { font-size: 0.9rem; color: var(--green-mid); font-weight: 500; }
.product-row ul.inline li::before { content: "— "; color: var(--gold); }

/* ==========================================================================
   FORM (Contact page)
   ========================================================================== */
.form-panel {
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 44px;
  box-shadow: var(--shadow);
}
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-bottom: 22px; }
@media (max-width: 640px) { .form-row { grid-template-columns: 1fr; } }
.field { display: flex; flex-direction: column; gap: 8px; }
.field.full { grid-column: 1 / -1; }
.field label {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--green-mid);
}
.field input, .field textarea {
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 13px 16px;
  background: var(--bg);
  color: var(--ink);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.field input:focus, .field textarea:focus {
  outline: none;
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(200,155,60,0.18);
}
.field textarea { resize: vertical; min-height: 110px; }
.field small { font-size: 0.76rem; color: #767a6d; }
.form-foot { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-top: 8px; }
.form-note { font-size: 0.84rem; color: #767a6d; max-width: 46ch; }
.form-status { font-family: var(--font-mono); font-size: 0.82rem; margin-top: 16px; display: none; }
.form-status.is-visible { display: block; }
.form-status.ok { color: var(--green-mid); }
.form-status.err { color: #a83c3c; }

/* Directory / contact cards */
.contact-directory { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
@media (max-width: 900px) { .contact-directory { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .contact-directory { grid-template-columns: 1fr; } }
.contact-card {
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 24px;
  background: var(--white);
}
.contact-card .role { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); margin-bottom: 8px; display: block; }
.contact-card .name { font-family: var(--font-display); font-size: 1.15rem; color: var(--green-deep); margin-bottom: 6px; }
.contact-card a.email { font-family: var(--font-mono); font-size: 0.86rem; color: var(--green-mid); word-break: break-all; }
.contact-card a.email:hover { color: var(--gold); }

.office-card { display: flex; gap: 18px; }
.office-card .idx {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--gold);
  padding-top: 4px;
}
.office-card address { font-style: normal; color: #3d4038; line-height: 1.65; }
.office-card h3 { margin-bottom: 10px; }

/* ==========================================================================
   FOOTER
   ========================================================================== */
.site-footer {
  background: var(--charcoal);
  color: rgba(255,255,255,0.72);
  padding: 84px 0 0;
  position: relative;
  overflow: hidden;
}
.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1.1fr;
  gap: 48px;
  padding-bottom: 60px;
}
@media (max-width: 980px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px) { .footer-grid { grid-template-columns: 1fr; } }
.footer-brand { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
.footer-brand img { height: 42px; border-radius: 6px; }
.footer-brand strong { font-family: var(--font-display); color: var(--white); font-size: 1.15rem; }
.site-footer p { color: rgba(255,255,255,0.6); font-size: 0.94rem; max-width: 34ch; }
.footer-col h4 {
  font-family: var(--font-mono);
  font-size: 0.74rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--gold-light);
  margin-bottom: 20px;
}
.footer-col ul { display: grid; gap: 12px; }
.footer-col a { font-size: 0.92rem; color: rgba(255,255,255,0.72); }
.footer-col a:hover { color: var(--gold-light); }
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.1);
  padding: 26px 0;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  font-family: var(--font-mono);
  font-size: 0.74rem;
  letter-spacing: 0.03em;
  color: rgba(255,255,255,0.45);
}

/* ==========================================================================
   Reveal-on-scroll
   ========================================================================== */
.reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
.reveal.is-visible { opacity: 1; transform: translateY(0); }

/* Utility */
.mt-0 { margin-top: 0; }
.text-center { text-align: center; }
@media (max-width: 900px) {
  .grid--2.split-cards { grid-template-columns: 1fr; }
}


/* ---------- Single-page routing ---------- */
.page { display: none; }
.page.is-active { display: block; }

nav a,
.nav-link,
.menu-item {
  color: var(--gold-light) !important;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

nav a:hover,
.nav-link:hover,
.menu-item:hover {
  color: var(--bg-alt) !important;
}

