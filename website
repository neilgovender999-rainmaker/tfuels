<script>

(function () {
  "use strict";

  /* ---------- Header solid-on-scroll ---------- */
  var header = document.querySelector(".site-header");
  function onScroll() {
    if (!header) return;
    if (window.scrollY > 40) header.classList.add("is-scrolled");
    else header.classList.remove("is-scrolled");
  }
  window.addEventListener("scroll", onScroll, { passive: true });

  /* ---------- Mobile nav ---------- */
  var hamburger = document.querySelector(".hamburger");
  var mobileNav = document.querySelector(".mobile-nav");
  function closeMobileNav() {
    if (!mobileNav) return;
    mobileNav.classList.remove("is-open");
    document.body.style.overflow = "";
    if (hamburger) hamburger.setAttribute("aria-expanded", "false");
  }
  if (hamburger && mobileNav) {
    hamburger.addEventListener("click", function () {
      var open = mobileNav.classList.toggle("is-open");
      hamburger.setAttribute("aria-expanded", open ? "true" : "false");
      document.body.style.overflow = open ? "hidden" : "";
    });
    mobileNav.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", closeMobileNav);
    });
  }

  /* ---------- Reveal on scroll ---------- */
  var canObserve = "IntersectionObserver" in window;
  var io = canObserve ? new IntersectionObserver(
    function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          io.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.14, rootMargin: "0px 0px -60px 0px" }
  ) : null;

  /* ---------- Hash-based page routing ---------- */
  var sections = document.querySelectorAll(".page");
  var navLinks = document.querySelectorAll(".nav__links a, .mobile-nav a, a.footer-nav-link");

  function route() {
    var id = (location.hash || "#home").replace("#", "");
    if (!document.getElementById("page-" + id)) id = "home";

    sections.forEach(function (s) {
      s.classList.toggle("is-active", s.id === "page-" + id);
    });

    document.querySelectorAll(".nav__links a, .mobile-nav a").forEach(function (a) {
      var target = (a.getAttribute("href") || "").replace("#", "");
      a.classList.toggle("is-active", target === id);
    });

    window.scrollTo(0, 0);
    closeMobileNav();

    var active = document.getElementById("page-" + id);
    if (active) {
      var reveals = active.querySelectorAll(".reveal");
      reveals.forEach(function (el) {
        if (el.classList.contains("is-visible")) return;
        if (io) io.observe(el);
        else el.classList.add("is-visible");
      });
    }

    document.title = pageTitles[id] || pageTitles.home;
  }

  var pageTitles = {
    home: "Trinity Fuels (Pty) Ltd — Fueling Africa's Growth",
    about: "About Us — Trinity Fuels (Pty) Ltd",
    products: "Products & Services — Trinity Fuels (Pty) Ltd",
    csr: "CSR & Compliance — Trinity Fuels (Pty) Ltd",
    contact: "Contact Us — Trinity Fuels (Pty) Ltd"
  };

  window.addEventListener("hashchange", route);
  window.addEventListener("DOMContentLoaded", function () {
    onScroll();
    route();
  });

  /* ---------- Footer year ---------- */
  document.querySelectorAll("[data-year]").forEach(function (el) {
    el.textContent = new Date().getFullYear();
  });

  /* ---------- Contact form ---------- */
  document.addEventListener("submit", function (e) {
    if (e.target && e.target.id === "enquiry-form") {
      e.preventDefault();
      var form = e.target;
      var status = document.getElementById("form-status");

      var required = form.querySelectorAll("[required]");
      var valid = true;
      required.forEach(function (field) {
        if (!field.value.trim()) valid = false;
      });

      if (!valid) {
        status.textContent = "Please complete all required fields before submitting.";
        status.className = "form-status is-visible err";
        return;
      }

      var data = new FormData(form);
      var body =
        "First Name: " + data.get("firstName") + "\n" +
        "Surname: " + data.get("surname") + "\n" +
        "Company: " + data.get("company") + "\n" +
        "Mobile: " + data.get("mobile") + "\n" +
        "Email: " + data.get("email") + "\n\n" +
        "Enquiry:\n" + data.get("enquiry");

      var mailto =
        "mailto:Info@TrinityFuels.co.za" +
        "?subject=" + encodeURIComponent("Website Enquiry — " + data.get("company")) +
        "&body=" + encodeURIComponent(body);

      window.location.href = mailto;

      status.textContent = "Thank you — your email client is opening so you can send your enquiry to Info@TrinityFuels.co.za.";
      status.className = "form-status is-visible ok";
      form.reset();
    }
  });
})();

</script>
